# Maps JavaScript API key. When this is set, the on-site map uses Google Maps.
# Leave it empty to use OpenStreetMap. Center links still open Google Maps either way.
VITE_GOOGLE_MAPS_API_KEY=

# Launch origin, no trailing slash. Canonicals, the sitemap index, and the
# Sitemap line in robots.txt use this host. Leave it empty until that .co.il
# domain is chosen. Do not put a preview address here.
VITE_SITE_URL=
